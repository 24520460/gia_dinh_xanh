{
  "name": "gia-dinh-xanh-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@gdx/web",
    "dev:api": "turbo run dev --filter=@gdx/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "pnpm --filter=@gdx/api run migration:run",
    "db:generate": "pnpm --filter=@gdx/api run migration:generate"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.12.0"
}
