PORT=4000
NODE_ENV=development

# Thông số kết nối Supabase PostgreSQL 16 (Schema v2.1)
# Lấy từ Supabase Dashboard: Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Thông tin dự án Supabase (Dùng cho Supabase Storage / Realtime)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Bảo mật JWT & Mã hóa CCCD (Mục 12.1 — Nghị định 13/2023: AES-256 + HMAC-SHA256 Pepper)
JWT_SECRET=super_secret_jwt_key_2026
CCCD_ENCRYPTION_KEY=gdx_aes256_cccd_vault_key_change_in_prod
CCCD_HMAC_PEPPER=gdx_hmac_sha256_pepper_secret_change_in_prod

# Thông tin tạo user test
TEST_USER_COUNT=30
TEST_USER_PREFIX=gdx-test-
TEST_USER_PASSWORD=TestPassword123!
ALLOW_TEST_USER_SEED=true
