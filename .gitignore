# ==========================================
# Gia Đình Xanh Monorepo - Git Ignore
# ==========================================

# 1. Environment & Secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# 2. Monorepo Dependencies & Turborepo Cache
node_modules/
.pnpm-store/
.turbo/
*.tsbuildinfo

# 3. Build & Distribution Outputs
dist/
dist-ssr/
build/
out/
.cache/

# 4. Runtime & Debug Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 5. Operating System Specific Files
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# 6. IDE & Editor Files
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# 7. Temporary Files
*.bak
*.tmp
*.temp
.system_generated/
